Procedure ProbeArt;   { read-only: what is the bottom-silk artwork made of? counts free primitives per kind -> tools/altium/probe_art.txt }
Var It : IPCB_BoardIterator; O : IPCB_Primitive; S : TStringList; NR, NT, NA, NF, NX, NC, NO_ : Integer; Rc : TCoordRect; L, R, Bt, Tp : Integer;
Begin
  Board := PCBServer.GetPCBBoardByPath('C:\Users\Public\Documents\Altium\Squid-Debugger\Squid-Debugger\hardware\DebugBoard.PcbDoc');
  If Board = Nil Then Board := PCBServer.GetCurrentPCBBoard;
  If Board = Nil Then Begin ShowMessage('Open DebugBoard.PcbDoc first'); Exit; End;
  X0 := 11558.4886; Y0 := 3895.504;
  NR := 0; NT := 0; NA := 0; NF := 0; NX := 0; NC := 0; NO_ := 0; L := 2147483647; Bt := 2147483647; R := -2147483647; Tp := -2147483647;
  It := Board.BoardIterator_Create; It.AddFilter_ObjectSet(AllObjects); It.AddFilter_LayerSet(MkSet(eBottomOverlay)); It.AddFilter_Method(eProcessAll);
  O := It.FirstPCBObject;
  While O <> Nil Do Begin
    If O.InComponent Then NC := NC + 1 Else Begin
      If O.ObjectId = eRegionObject Then NR := NR + 1 Else If O.ObjectId = eTrackObject Then NT := NT + 1 Else If O.ObjectId = eArcObject Then NA := NA + 1
      Else If O.ObjectId = eFillObject Then NF := NF + 1 Else If O.ObjectId = eTextObject Then NX := NX + 1 Else NO_ := NO_ + 1;
      If O.ObjectId <> eTextObject Then Begin
        Rc := O.BoundingRectangle;
        If Rc.Left < L Then L := Rc.Left; If Rc.Right > R Then R := Rc.Right; If Rc.Bottom < Bt Then Bt := Rc.Bottom; If Rc.Top > Tp Then Tp := Rc.Top;
      End;
    End;
    O := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  S := TStringList.Create;
  S.Add('free on Bottom Overlay: regions ' + IntToStr(NR) + ' tracks ' + IntToStr(NT) + ' arcs ' + IntToStr(NA) + ' fills ' + IntToStr(NF) + ' texts ' + IntToStr(NX) + ' other ' + IntToStr(NO_) + '   in components ' + IntToStr(NC));
  S.Add('extent of free non-text primitives (mil from origin): ' + FloatToStr(CoordToMils(L) - X0) + ' ' + FloatToStr(CoordToMils(Bt) - Y0) + ' ' + FloatToStr(CoordToMils(R) - X0) + ' ' + FloatToStr(CoordToMils(Tp) - Y0));
  S.SaveToFile('C:\Users\Public\Documents\Altium\Squid-Debugger\Squid-Debugger\tools\altium\probe_art.txt');
  ShowMessage(S.Text); S.Free;
End;

Procedure WipeRound(X, Y, R : Double);   { remove bottom-silk artwork dots whose centre is inside a circle (round pads) }
Var SI : IPCB_SpatialIterator; O : IPCB_Primitive; Lst : TInterfaceList; I : Integer; Rc : TCoordRect; Cx, Cy, Dx, Dy, Rr : Double;
Begin
  Cx := X0 + X / 0.0254; Cy := Y0 + Y / 0.0254; Rr := R / 0.0254;
  Lst := TInterfaceList.Create; SI := Board.SpatialIterator_Create;
  SI.AddFilter_ObjectSet(MkSet(eRegionObject)); SI.AddFilter_LayerSet(MkSet(eBottomOverlay));
  SI.AddFilter_Area(MilsToCoord(Cx - Rr), MilsToCoord(Cy - Rr), MilsToCoord(Cx + Rr), MilsToCoord(Cy + Rr));
  O := SI.FirstPCBObject;
  While O <> Nil Do Begin
    If Not O.InComponent Then Begin
      Rc := O.BoundingRectangle;
      Dx := CoordToMils((Rc.Left + Rc.Right) Div 2) - Cx; Dy := CoordToMils((Rc.Bottom + Rc.Top) Div 2) - Cy;
      If Dx * Dx + Dy * Dy < Rr * Rr Then Lst.Add(O);
    End;
    O := SI.NextPCBObject;
  End;
  Board.SpatialIterator_Destroy(SI);
  For I := 0 To Lst.Count - 1 Do Board.RemovePCBObject(Lst.Items[I]);
  Wiped := Wiped + Lst.Count; Lst.Free;
End;

Function ProbeOne(F : String; Rx, Ry, Rz : Double) : String;   { projected size of a STEP model for one rotation }
Var B : IPCB_ComponentBody; Mdl : IPCB_Model; Rb : TCoordRect;
Begin
  B := PCBServer.PCBObjectFactory(eComponentBodyObject, eNoDimension, eCreate_Default);
  Mdl := B.ModelFactory_FromFilename(F, False);
  Mdl.SetState(Rx, Ry, Rz, 0); B.Model := Mdl; B.SetState_FromModel;
  Board.AddPCBObject(B);
  Rb := B.BoundingRectangle;
  Result := FloatToStr(Rx) + ',' + FloatToStr(Ry) + ',' + FloatToStr(Rz) + ': x ' + FloatToStr(Round(CoordToMils(Rb.Left) * 2.54) / 100) + '..' + FloatToStr(Round(CoordToMils(Rb.Right) * 2.54) / 100) + ' y ' + FloatToStr(Round(CoordToMils(Rb.Bottom) * 2.54) / 100) + '..' + FloatToStr(Round(CoordToMils(Rb.Top) * 2.54) / 100) + ' | ';
  Board.RemovePCBObject(B);
End;

