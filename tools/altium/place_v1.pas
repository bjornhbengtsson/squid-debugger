Procedure Labels;
Var It : IPCB_BoardIterator; T : IPCB_Text; X, Y : Double; Lst : TInterfaceList; I : Integer; Flat : Boolean;
Begin
  Lst := TInterfaceList.Create;
  It := Board.BoardIterator_Create; It.AddFilter_ObjectSet(MkSet(eTextObject));
  It.AddFilter_LayerSet(AllLayers); It.AddFilter_Method(eProcessAll);
  T := It.FirstPCBObject;
  While T <> Nil Do Begin
    X := -1;
    If Not T.InComponent Then Begin
      Flat := (Round(T.Rotation) Mod 180) = 0;
      If Flat And (T.Size < MilsToCoord(40)) And ((T.Text = '5V') Or (T.Text = '5V RF')) Then Lst.Add(T);   { labels of the deleted V0 jumper P1 }
      If Pos('Squid Debugger V0', T.Text) > 0 Then Begin T.BeginModify; T.Text := StringReplace(T.Text, 'Squid Debugger V0', 'Squid Debugger V1', 0); T.EndModify; End;
      If Pos('sufficiently advanced', T.Text) > 0 Then Lst.Add(T);   { the Clarke quote: removed on request }
      If T.Text = 'TX RX' Then Begin
        T.BeginModify; T.Size := MilsToCoord(1.3 / 0.0254); T.Width := MilsToCoord(0.2 / 0.0254); T.EndModify;
        T.BeginModify;
        T.MoveByXY(MilsToCoord(X0 + 15.1 / 0.0254) - (T.BoundingRectangleForSelection.Left + T.BoundingRectangleForSelection.Right) Div 2, MilsToCoord(Y0 + 70.75 / 0.0254) - (T.BoundingRectangleForSelection.Bottom + T.BoundingRectangleForSelection.Top) Div 2);
        T.EndModify; T.GraphicallyInvalidate;
      End;
      If Flat Then Begin
        If T.Text = '+3.3V' Then Begin X := 3.58; Y := 78.7; End;
        If T.Text = '+5V' Then Begin X := 51.55; Y := 78.7; End;
        If T.Text = '+12V' Then Begin X := 4.33; Y := 26.3; End;
        If T.Text = '+5V RF' Then Begin X := 49.3; Y := 26.3; End;
        If T.Text = 'GND' Then Begin X := 28.2; Y := 30.25; End;
      End;
    End;
    If X >= 0 Then Begin
      T.BeginModify; T.Size := MilsToCoord(1.5 / 0.0254); T.Width := MilsToCoord(0.25 / 0.0254); T.EndModify;
      T.BeginModify;
      T.MoveByXY(MilsToCoord(X0 + X / 0.0254) - T.BoundingRectangleForSelection.Left, MilsToCoord(Y0 + Y / 0.0254) - T.BoundingRectangleForSelection.Bottom);
      T.EndModify; T.GraphicallyInvalidate;
    End;
    T := It.NextPCBObject;
  End;
  Board.BoardIterator_Destroy(It);
  For I := 0 To Lst.Count - 1 Do Board.RemovePCBObject(Lst.Items[I]);
  Lst.Free;
End;

Function M(V : Integer; Ref : Double) : String;
Begin
  Result := FloatToStr(Round((CoordToMils(V) - Ref) * 100) / 100);
End;

Function R2S(Rc : TCoordRect) : String;
Begin
  Result := M(Rc.Left, X0) + '|' + M(Rc.Bottom, Y0) + '|' + M(Rc.Right, X0) + '|' + M(Rc.Top, Y0);
End;

Function ZRange(F : String; Rx : Double) : String;
{ Height range of a STEP model when turned Rx about X: a body turned a further 90 degrees shows its height
  axis in the plan view (plan y = -height), so its box gives the lowest and highest point. }
Var B : IPCB_ComponentBody; Mdl : IPCB_Model; Rb : TCoordRect;
Begin
  B := PCBServer.PCBObjectFactory(eComponentBodyObject, eNoDimension, eCreate_Default);
  Mdl := B.ModelFactory_FromFilename(F, False);
  Mdl.SetState(Rx + 90, 0, 0, 0); B.Model := Mdl; B.SetState_FromModel;
  Board.AddPCBObject(B);
  Rb := B.BoundingRectangle;
  Result := FloatToStr(Round(-CoordToMils(Rb.Top) * 2.54) / 100) + '|' + FloatToStr(Round(-CoordToMils(Rb.Bottom) * 2.54) / 100);
  Board.RemovePCBObject(B);
End;

Function ProbeT(D : String) : String;
Var C : IPCB_Component; T : IPCB_Text;
Begin
  C := Board.GetPcbComponentByRefDes(D); T := C.Name;
  Result := D + ' loc ' + M(T.XLocation, X0) + ',' + M(T.YLocation, Y0) + ' box ' + R2S(T.BoundingRectangle) + ' sel ' + R2S(T.BoundingRectangleForSelection) + ' size ' + M(T.Size, 0) + ' w ' + M(T.Width, 0) + ' rot ' + FloatToStr(T.Rotation) + ' frameW ' + M(T.MultilineTextWidth, 0) + ' frameH ' + M(T.MultilineTextHeight, 0) + ' ttf ' + IntToStr(Ord(T.UseTTFonts)) + ' mirror ' + IntToStr(Ord(T.MirrorFlag)) + ' auto ' + IntToStr(Ord(C.NameAutoPosition)) + #13#10;
End;

