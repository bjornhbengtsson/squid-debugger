    If L.LayerID = eMidLayer1 Then Begin
      L.Dielectric.DielectricHeight := MilsToCoord(41.93); L.Dielectric.DielectricConstant := 4.6; L.Dielectric.DielectricMaterial := 'FR-4';
    End;
    L := Stack.NextLayer(L);
  End;
  ShowMessage('Layer stack set');
End;

