Procedure LibPad(Comp : IPCB_LibComponent; Lib : IPCB_Library; Nm : String; X, Y, W, H : Double);
Var Pd : IPCB_Pad; Ox, Oy : Integer;
Begin
  Trace('pad ' + Nm + ' a');
